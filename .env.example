# --- Database (Neon / Vercel Postgres) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- Paystack (Dashboard > Settings > API Keys & Webhooks) ---
PAYSTACK_SECRET_KEY="sk_test_PASTE_YOUR_KEY_HERE"
PAYSTACK_PUBLIC_KEY="pk_test_PASTE_YOUR_KEY_HERE"

# --- Brevo (SMTP & API > API Keys) ---
BREVO_API_KEY="xkeysib-PASTE_YOUR_KEY_HERE"
BREVO_SENDER_EMAIL="bookings@yourdomain.com"
BREVO_SENDER_NAME="Embata Massage Spa"

# --- Admin panel ---
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="choose-a-strong-password"
SESSION_SECRET="32+ random bytes, e.g. openssl rand -hex 32"

# --- Public site URL (Paystack callback + admin links) ---
# Optional on Vercel: when unset, the code falls back to
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL. Set it to your canonical
# custom domain if you have one.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
